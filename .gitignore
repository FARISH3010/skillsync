# ====================================================================
# Git Ignore Rules for SkillSync
# ====================================================================

# 1. API Keys & Secrets (CRITICAL: NEVER COMMIT SECRETS TO GITHUB)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
*.pem
*.key
credentials.json

# 2. Virtual Environments
venv/
env/
ENV/
.venv/
*/venv/
*/env/

# 3. Python Cache & Build Artifacts
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
bin/
var/
sdist/
develop-eggs/
.installed.cfg
.pytest_cache/
.coverage
htmlcov/

# 4. SQLite Databases & Local Storage
*.db
*.sqlite
*.sqlite3
backend/skillsync.db
backend/*.db

# 5. Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Operating System & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# 7. Uploaded Test Files / Scratch Storage
uploads/
backend/uploads/
scratch/
*.log
