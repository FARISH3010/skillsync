# ====================================================================
# SkillSync Environment Variables Example
# Copy this file to .env and insert your actual API keys.
# ====================================================================

# 1. Google Gemini API Key (Required for multi-discipline AI analysis)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Database URL (Default SQLite)
DATABASE_URL=sqlite:///./skillsync.db

# 3. RapidAPI JSearch Key (Optional: for live LinkedIn / Indeed job market data)
# Get a free key at: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here
